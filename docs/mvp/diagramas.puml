@startuml SecuenciaLogin
title CMS Multipais - Secuencia Login Admin

actor Administrador
participant "React LoginPage" as UI
participant "Axios" as Axios
participant "Express /api/auth/login" as API
participant "AuthService" as Service
database "Supabase usuarios" as DB

Administrador -> UI: Ingresa usuario y contrasena
UI -> Axios: POST /api/auth/login
Axios -> API: Credenciales
API -> Service: loginUser(username, password)
Service -> DB: Buscar usuario, rol y pais
DB --> Service: Datos + password_hash
Service -> Service: Verificar bcrypt y estado
Service -> Service: Generar JWT
Service --> API: token + user
API --> Axios: 200 JSON
Axios --> UI: Guardar sesion
UI --> Administrador: Redirigir a dashboard
@enduml

@startuml ActividadSolicitud
title CMS Multipais - Actividad Enviar Solicitud Publica

start
:Visitante abre portal por pais;
:Selecciona formulario de solicitudes;
:Completa datos de contacto;
if (Formulario valido?) then (Si)
  :React envia POST /api/solicitudes/public;
  :Backend valida datos;
  :Supabase guarda solicitud;
  :Sistema confirma envio;
else (No)
  :Interfaz muestra errores;
endif
stop
@enduml

