@startuml Arquitectura
title CMS Multipais - Diagrama de Arquitectura

actor Visitante
actor Administrador

node "Frontend React + Vite" as Frontend {
  component "Portal publico" as Portal
  component "Panel admin" as Admin
  component "Axios client" as Axios
}

node "Backend Node.js + Express" as Backend {
  component "Rutas REST" as Routes
  component "Controladores" as Controllers
  component "Servicios" as Services
  component "Auth/RBAC middleware" as Auth
}

cloud "Supabase" as Supabase {
  database "PostgreSQL" as DB
  component "Storage" as Storage
}

Visitante --> Portal
Administrador --> Admin
Portal --> Axios
Admin --> Axios
Axios --> Routes
Routes --> Auth
Routes --> Controllers
Controllers --> Services
Services --> DB
Services --> Storage
@enduml

