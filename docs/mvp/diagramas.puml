database "Supabase PostgreSQL" as DB
cloud "Supabase Storage" as Storage

[PublicLayout] --> [Servicios API]
[AdminLayout] --> [AuthContext]
[AdminLayout] --> [ProtectedRoute]
[ProtectedRoute] --> [RoleRoute]
[Servicios API] --> [authRoutes]
[Servicios API] --> [noticiaRoutes]
[Servicios API] --> [testimonioRoutes]
[Servicios API] --> [solicitudRoutes]
[Servicios API] --> [userRoutes]
[Servicios API] --> [auditRoutes]
[Servicios API] --> [publicRoutes]

[authRoutes] --> [Services]
[noticiaRoutes] --> [Services]
[testimonioRoutes] --> [Services]
[solicitudRoutes] --> [Services]
[userRoutes] --> [Services]
[auditRoutes] --> [Services]
[publicRoutes] --> [Services]
[Services] --> [Supabase config]
